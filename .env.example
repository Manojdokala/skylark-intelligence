# Server-side Environment Variables
PORT=5000

# Monday.com API Configuration
# Get your token from Monday.com -> Admin -> API
MONDAY_API_TOKEN=your_monday_api_token_here
MONDAY_DEALS_BOARD_ID=1234567890
MONDAY_WORK_ORDERS_BOARD_ID=0987654321

# Optional Gemini API Key for Natural Language Insights
# If not set, system seamlessly falls back to structured deterministic responses
GEMINI_API_KEY=
